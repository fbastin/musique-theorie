  <work>
    <work-title>Les cadences dans toutes les tonalités</work-title>
  </work>
  <identification>
    <creator type="composer">Fabian Bastin</creator>
    <rights>Licence MIT</rights>
    <encoding>
      <software>dépôt musique-theorie, dossier outils</software>
      <encoding-date>2026-10-19</encoding-date>
    </encoding>
    <miscellaneous>
      <miscellaneous-field name="description">I–IV–V–I et I–V7–I en style clavier, trois sons à la main droite et la basse seule, en position d'octave, dans les trente tonalités : chaque majeur, puis son homonyme mineur ; un accord par blanche, à la noire 80.</miscellaneous-field>
    </miscellaneous>
  </identification>
