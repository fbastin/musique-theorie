    <miscellaneous>
      <miscellaneous-field name="description">La gamme chromatique, écrite avec des dièses en montant et des bémols en descendant, puis la gamme pentatonique et la gamme par tons, sur do.</miscellaneous-field>
    </miscellaneous>
  </identification>
